# Modo seguro por defecto. No introducir credenciales ni datos privados.
VITE_FIREBASE_MODE=emulator
VITE_FIREBASE_PROJECT_ID=demo-seguimiento-ci
# Host y puertos provienen de firebase.json; nunca fallback a nube.
# Staging permanece bloqueado por config/staging-target.json pendiente.
# Una vez verificado el destino, npm run build:staging prepara el SHA y valores
# públicos desde private/staging-web.json. No usar este archivo para secretos.
# Procedimiento: docs/validacion-nube-fase-2.md.
